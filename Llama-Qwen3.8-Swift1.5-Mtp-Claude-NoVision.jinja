{%- set template_version = "Llama-Qwen3.8-Swift1.5-Mtp-Claude-NoVision-v1.1" %}
{%- set add_vision_id = add_vision_id if add_vision_id is defined else false %}
{%- set enable_thinking = enable_thinking if enable_thinking is defined else true %}
{%- set _preserve_thinking = preserve_thinking if (preserve_thinking is defined and preserve_thinking is not none) else (preserve_reasoning if (preserve_reasoning is defined and preserve_reasoning is not none) else false) %}
{%- set _has_tools = (tools is defined and tools and tools is iterable and tools is not mapping) %}
{%- set image_count = namespace(value=0) %}

{%- set _effort_raw = (reasoning_effort | string | lower) if (reasoning_effort is defined and reasoning_effort is not none) else 'medium' %}
{%- set _init_think = false if _effort_raw in ('none', 'off') else enable_thinking %}
{%- set _init_effort = 'low' if _effort_raw in ('minimal', 'low') else ('xhigh' if _effort_raw in ('high', 'xhigh', 'max', 'ultracode', 'extreme') else 'medium') %}
{%- set ns_state = namespace(thinking=_init_think, effort=_init_effort, overridden=false) %}

{%- set _think_tokens = ['<|think_off|>', '<|think_on|>', '<|think_xhigh|>', '<|think_high|>', '<|think_ultracode|>', '<|think_extreme|>', '<|think_max|>', '<|think_medium|>', '<|think_low|>', '<|think_minimal|>'] %}

{%- macro parse_and_strip(text, update_state=false) %}
    {%- set _t = text if text is string else (text | string) %}
    {%- if update_state and '<|think_' in _t %}
        {%- if '<|think_off|>' in _t %}{%- set ns_state.thinking = false %}
        {%- elif '<|think_on|>' in _t %}{%- set ns_state.thinking = true %}
        {%- elif '<|think_xhigh|>' in _t or '<|think_high|>' in _t or '<|think_ultracode|>' in _t or '<|think_extreme|>' in _t or '<|think_max|>' in _t %}
            {%- set ns_state.thinking = true %}{%- set ns_state.effort = 'xhigh' %}{%- set ns_state.overridden = true %}
        {%- elif '<|think_low|>' in _t or '<|think_minimal|>' in _t %}
            {%- set ns_state.thinking = true %}{%- set ns_state.effort = 'low' %}{%- set ns_state.overridden = true %}
        {%- elif '<|think_medium|>' in _t %}
            {%- set ns_state.thinking = true %}{%- set ns_state.effort = 'medium' %}{%- set ns_state.overridden = true %}
        {%- endif %}
    {%- endif %}
    {%- if '<|think_' in _t %}
        {%- for tok in _think_tokens %}{%- set _t = _t.replace(tok, '') %}{%- endfor %}
    {%- endif %}
    {{- _t | trim }}
{%- endmacro %}

{%- macro render_content(content, count_vision) %}
    {%- if content is string %}{{- content }}
    {%- elif content is iterable and content is not mapping %}
        {%- for item in content %}
            {%- if item is mapping %}
                {%- set t = item.type | default('unknown') %}
                {%- if t == 'text' and item.text is defined %}{{- item.text }}
                {%- elif t == 'image' or 'image' in item or 'image_url' in item %}
                    {{- '[Image omitted - NoVision template]' }}
                {%- elif t == 'thinking' and (item.thinking is defined or item.text is defined) %}
                    {{- '<think>\n' ~ (item.thinking | default(item.text)) ~ '\n</think>' }}
                {%- elif t == 'tool_reference' %}
                    {{- '[Tool reference: ' ~ (item.tool_name | default(item.name | default('unknown'))) ~ ']' }}
                {%- elif t in ('tool_use', 'server_tool_use', 'mcp_tool_use') %}
                    {{- '[Tool call: ' ~ (item.name | default(item.tool_name | default('unknown'))) ~ (' ' ~ (item.input | tojson) if item.input is defined else '') ~ ']' }}
                {%- elif t in ('tool_result', 'web_search_tool_result', 'code_execution_tool_result') %}
                    {%- set _tr_body = (render_content(item.content, count_vision) if item.content is defined else (item.text if item.text is defined else '')) | trim %}
                    {{- ('\n' if not loop.first else '') ~ '<tool_response>\n' ~ _tr_body ~ '\n</tool_response>' }}
                {%- elif t == 'redacted_thinking' %}{{- '[Redacted thinking]' }}
                {%- elif t == 'document' %}
                    {{- '[Document]' ~ (' ' ~ item.title if item.title is defined else '') ~ ('\n' ~ item.text if item.text is defined else '') }}
                {%- elif item.text is defined and item.text is string %}{{- item.text }}
                {%- else %}{{- '[' ~ t ~ ']' }}
                {%- endif %}
            {%- else %}{{- item | string }}
            {%- endif %}
        {%- endfor %}
    {%- elif content is not none and content is not undefined %}{{- raise_exception('Unexpected content type: ' ~ (content | string)) }}
    {%- endif %}
{%- endmacro %}

{%- if not messages %}{{- raise_exception('No messages provided.') }}{%- endif %}

{# ---- First pass: detect inline <|think_*|> overrides across system/user turns ---- #}
{%- for msg in messages %}
    {%- if msg.role in ('system', 'developer', 'user') %}
        {%- set _ = parse_and_strip(render_content(msg.content, false), true) %}
    {%- endif %}
{%- endfor %}

{%- set reasoning_instructions = '' %}
{%- if ns_state.thinking %}
    {%- if ns_state.effort == 'xhigh' %}
        {%- set reasoning_instructions = 'Reasoning effort is set to xhigh. Think carefully through the task, validate key assumptions, consider plausible alternatives, and prioritize correctness, consistency, and clarity in the final answer.' %}
    {%- elif ns_state.effort == 'low' %}
        {%- set reasoning_instructions = 'Reasoning effort is set to low. Keep your thinking brief and focused, moving directly to the conclusion without unnecessary elaboration.' %}
    {%- elif ns_state.effort == 'medium' and ns_state.overridden %}
        {%- set reasoning_instructions = 'Reasoning effort is set to medium. Use balanced, concise reasoning before answering or calling tools.' %}
    {%- endif %}
{%- endif %}

{# ---- Aggregate leading system/developer messages ---- #}
{%- set head = namespace(count=0, seen=false) %}
{%- for message in messages %}
    {%- if message.role in ('system', 'developer') and not head.seen %}{%- set head.count = head.count + 1 %}
    {%- else %}{%- set head.seen = true %}{%- endif %}
{%- endfor %}
{%- set sys_state = namespace(content='') %}
{%- for message in messages[:head.count] %}
    {%- set _part = parse_and_strip(render_content(message.content, false)) %}
    {%- if _part %}{%- set sys_state.content = (sys_state.content ~ '\n\n' ~ _part) if sys_state.content else _part %}{%- endif %}
{%- endfor %}
{%- set _sc = sys_state.content %}
{%- set _msgs = messages[head.count:] %}

{# ---- System prompt + XML tool schema ---- #}
{%- if _has_tools %}
    {{- '<|im_start|>system\n' ~ (reasoning_instructions + '\n\n' if reasoning_instructions else '') ~ '# Tools\n\nYou have access to the following functions:\n\n<tools>' }}
    {%- for tool in tools %}{{- '\n' ~ (tool | tojson) }}{%- endfor %}
    {{- '\n</tools>\n\nIf you choose to call a function ONLY reply in the following format with NO suffix:\n\n' ~ ('<think>\nBrief explanation of tool call\n</think>\n' if ns_state.thinking else '') ~ '<tool_call>\n<function=example_function_name>\n<parameter=example_parameter_1>\nvalue_1\n</parameter>\n<parameter=example_parameter_2>\nThis is the value for the second parameter\nthat can span\nmultiple lines\n</parameter>\n</function>\n</tool_call>\n\n<IMPORTANT>\nReminder:\n' ~ ('- You can use the <think></think> block to plan your next tool call OR to synthesize data and formulate your final response to the user.\n- ALL explanation and reasoning MUST be placed strictly inside the <think></think> block.\n' if ns_state.thinking else '') ~ '- Function calls MUST follow the specified format: an inner <function=...></function> block must be nested within <tool_call></tool_call> XML tags.\n- If you choose to call a tool, you MUST output the <tool_call> block IMMEDIATELY' ~ (' after thinking' if ns_state.thinking else '') ~ ', with NO conversational text before it.\n- The <tool_call> and <function> tags MUST be at the very beginning of a new line, with NO spaces or indentation before them.\n- To call multiple functions, output a separate, completely closed <tool_call></tool_call> block for EACH function. Do NOT nest <tool_call> blocks.\n- If you have all necessary data, provide your final answer directly to the user without any tool call.\n</IMPORTANT>' ~ ('\n\n' + _sc if _sc else '') ~ '<|im_end|>\n' }}
{%- elif _sc or reasoning_instructions %}
    {{- '<|im_start|>system\n' ~ (reasoning_instructions + '\n\n' if reasoning_instructions else '') ~ _sc ~ '<|im_end|>\n' }}
{%- endif %}

{# ---- Active-turn boundary for thinking retention ---- #}
{%- set _last_idx = (_msgs | length) - 1 %}
{%- set ns = namespace(multi_step_tool=true, last_query_index=_last_idx) %}
{%- for message in _msgs[::-1] %}
    {%- set index = ((_msgs | length) - 1) - loop.index0 %}
    {%- if ns.multi_step_tool and message.role == 'user' %}
        {%- set _rc = render_content(message.content, false) | trim %}
        {%- if not (_rc.startswith('<tool_response>') and _rc.endswith('</tool_response>')) %}
            {%- set ns.multi_step_tool = false %}{%- set ns.last_query_index = index %}
        {%- endif %}
    {%- endif %}
{%- endfor %}
{%- if ns.multi_step_tool %}{%- set ns.last_query_index = _last_idx if _last_idx > 50 else 0 %}{%- endif %}

{# ---- Main message loop ---- #}
{%- set ns2 = namespace(prev_role='') %}
{%- for message in _msgs %}
    {%- set is_system = (message.role in ('system', 'developer')) %}
    {%- set content = parse_and_strip(render_content(message.content, true)) if (is_system or message.role == 'user') else (render_content(message.content, true) | trim) %}

    {%- if is_system %}
        {{- '<|im_start|>system\n' + content + '<|im_end|>\n' }}
    {%- elif message.role == 'user' %}
{{- '<|im_start|>user\n' + content + '<|im_end|>\n' }}
    {%- elif message.role == 'assistant' %}
        {%- set reasoning_content = '' %}
        {%- set _explicit = message.reasoning_content if (message.reasoning_content is defined and message.reasoning_content is not none) else (message.thinking if (message.thinking is defined and message.thinking is not none) else (message.reasoning if (message.reasoning is defined and message.reasoning is not none) else '')) %}
        {%- if _explicit %}
            {%- set reasoning_content = _explicit | string %}
            {%- if '</think>' in content and (content.startswith('<think>') or content.startswith('</think>')) %}
                {%- set content = content.split('</think>', 1)[-1].lstrip('\n') %}
            {%- endif %}
        {%- elif content.lstrip().startswith('<think>') or content.lstrip().startswith('</think>') or '\n</think>' in content %}
            {%- set reasoning_content = content.split('</think>', 1)[0].split('<think>')[-1].strip('\n') %}
            {%- set content = content.split('</think>', 1)[-1].lstrip('\n') %}
        {%- endif %}
        {%- set reasoning_content = reasoning_content | trim %}

        {{- '<|im_start|>assistant\n' ~ ('<think>\n' + reasoning_content + '\n</think>\n\n' if (reasoning_content and (_preserve_thinking or loop.index0 > ns.last_query_index)) else '') ~ content }}

        {%- if message.tool_calls is defined and message.tool_calls and message.tool_calls is iterable and message.tool_calls is not mapping %}
            {%- for tool_call in message.tool_calls %}
                {%- set tc = tool_call.function if (tool_call.function is defined and tool_call.function is not none) else tool_call %}
                {%- set tc_name = tc.name if (tc.name is defined and tc.name is not none) else '' %}
                {{- ('\n\n' if (loop.first and (content | trim)) else ('\n' if not loop.first else '')) ~ '<tool_call>\n<function=' ~ tc_name ~ '>\n' }}
                {%- if tc.arguments is defined and tc.arguments is not none %}
                    {%- if tc.arguments is mapping %}
                        {%- for k, v in tc.arguments.items() %}
                            {{- '<parameter=' ~ k ~ '>\n' ~ (v if v is string else (v | tojson)) ~ '\n</parameter>\n' }}
                        {%- endfor %}
                    {%- else %}
                        {%- set _raw = tc.arguments if tc.arguments is string else (tc.arguments | tojson) %}
                        {%- if _raw %}{{- _raw }}{%- endif %}
                    {%- endif %}
                {%- endif %}
                {{- '</function>\n</tool_call>' }}
            {%- endfor %}
        {%- endif %}
        {{- '<|im_end|>\n' }}
    {%- elif message.role == 'tool' %}
        {%- if ns2.prev_role != 'tool' %}{{- '<|im_start|>user' }}{%- endif %}
        {{- '\n<tool_response>\n' + content + '\n</tool_response>' }}
        {%- if loop.last or _msgs[loop.index0 + 1].role != 'tool' %}{{- '<|im_end|>\n' }}{%- endif %}
    {%- else %}
        {{- '<|im_start|>user\n[' + message.role + ']: ' + content + '<|im_end|>\n' }}
    {%- endif %}
    {%- set ns2.prev_role = message.role %}
{%- endfor %}

{%- if add_generation_prompt %}
    {{- '<|im_start|>assistant\n' ~ ('<think>\n' if ns_state.thinking else '<think>\n\n</think>\n\n') }}
{%- endif %}
